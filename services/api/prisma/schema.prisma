datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum UserRole {
  customer
  owner
  driver
  admin
}

enum VehicleType {
  mini_truck
  lcv
  hcv
  trailer
  tanker
  flatbed
  refrigerated
  open_body
}

enum VehicleStatus {
  available
  busy
  offline
}

enum KycStatus {
  pending
  approved
  rejected
}

enum TripType {
  rental
  return_leg
  shared
}

enum TripStatus {
  requested
  accepted
  en_route
  in_progress
  delivered
  cancelled
}

enum PricingMode {
  hourly
  trip
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  phone        String        @unique
  passwordHash String        @map("password_hash")
  role         UserRole
  name         String
  avatarUrl    String?       @map("avatar_url")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  ownedVehicles Vehicle[]    @relation("VehicleOwner")
  managedDrivers Driver[]    @relation("DriverOwner")
  driverProfile  Driver?     @relation("DriverUser")
  trips         Trip[]       @relation("CustomerTrips")
  reviewsGiven  Review[]     @relation("Reviewer")
  loads         LoadPosting[]
  kycReviewed    KycDocument[] @relation("KycReviewer")
  disputesRaised Dispute[]     @relation("DisputeRaiser")
  adminAuditLogs AuditLog[]    @relation("AdminAuditLogs")

  @@map("users")
}

model Vehicle {
  id              String        @id @default(uuid())
  ownerId         String        @map("owner_id")
  type            VehicleType
  capacityKg      Float         @map("capacity_kg")
  registration    String        @unique
  status          VehicleStatus @default(offline)
  baseRatePerKm   Float         @map("base_rate_per_km")
  baseRatePerHour Float         @map("base_rate_per_hour")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  owner           User          @relation("VehicleOwner", fields: [ownerId], references: [id])
  assignedDriver  Driver?       @relation("VehicleDriver")
  trips           Trip[]        @relation("VehicleTrips")

  @@index([ownerId])
  @@index([status])
  @@index([type])
  @@map("vehicles")
}

model Driver {
  id              String    @id @default(uuid())
  userId          String    @unique @map("user_id")
  ownerId         String    @map("owner_id")
  vehicleId       String?   @unique @map("vehicle_id")
  licenseNumber   String    @map("license_number")
  licenseExpiry   DateTime  @map("license_expiry")
  yearsExperience Int       @map("years_experience")
  kycStatus       KycStatus @default(pending) @map("kyc_status")
  ratingAvg       Float     @default(0) @map("rating_avg")
  ratingCount     Int       @default(0) @map("rating_count")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user            User      @relation("DriverUser", fields: [userId], references: [id])
  owner           User      @relation("DriverOwner", fields: [ownerId], references: [id])
  vehicle         Vehicle?  @relation("VehicleDriver", fields: [vehicleId], references: [id])
  availability    DriverAvailability[]
  trips           Trip[]    @relation("DriverTrips")
  kycDocuments    KycDocument[]

  @@index([ownerId])
  @@index([kycStatus])
  @@map("drivers")
}

model DriverAvailability {
  id        String @id @default(uuid())
  driverId  String @map("driver_id")
  dayOfWeek Int    @map("day_of_week")
  startTime String @map("start_time")
  endTime   String @map("end_time")

  driver    Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([driverId, dayOfWeek])
  @@map("driver_availability")
}

model Trip {
  id                 String               @id @default(uuid())
  type               TripType             @default(rental)
  customerId         String               @map("customer_id")
  vehicleId          String               @map("vehicle_id")
  driverId           String               @map("driver_id")
  originAddress      String               @map("origin_address")
  destinationAddress String               @map("destination_address")
  scheduledAt        DateTime             @map("scheduled_at")
  status             TripStatus           @default(requested)
  pricingMode        PricingMode          @map("pricing_mode")
  priceTotal         Float                @map("price_total")
  tollExpenses       Float                @default(0) @map("toll_expenses")
  priceBreakdown     Json                 @map("price_breakdown")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  customer           User                 @relation("CustomerTrips", fields: [customerId], references: [id])
  vehicle            Vehicle              @relation("VehicleTrips", fields: [vehicleId], references: [id])
  driver             Driver               @relation("DriverTrips", fields: [driverId], references: [id])
  route              Route?
  payment            Payment?
  parentTripId       String?              @map("parent_trip_id")
  parentTrip         Trip?                @relation("ParentTripRelation", fields: [parentTripId], references: [id])
  childTrips         Trip[]               @relation("ParentTripRelation")
  locationUpdates    TripLocationUpdate[]
  reviews            Review[]
  returnMatches      ReturnLoadMatch[]
  disputes           Dispute[]

  @@index([customerId])
  @@index([vehicleId])
  @@index([driverId])
  @@index([status])
  @@map("trips")
}

model Route {
  id         String @id @default(uuid())
  tripId     String @unique @map("trip_id")
  waypoints  Json
  distanceM  Float  @map("distance_m")
  durationS  Float  @map("duration_s")
  polyline   String

  trip       Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@map("routes")
}

model TripLocationUpdate {
  id         String   @id @default(uuid())
  tripId     String   @map("trip_id")
  recordedAt DateTime @default(now()) @map("recorded_at")

  trip       Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@map("trip_location_updates")
}

model Payment {
  id                String   @id @default(uuid())
  tripId            String   @unique @map("trip_id")
  razorpayOrderId   String   @unique @map("razorpay_order_id")
  razorpayPaymentId String?  @map("razorpay_payment_id")
  razorpaySignature String?  @map("razorpay_signature")
  amount            Float
  status            String
  encryptedPayload  String   @map("encrypted_payload")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  trip              Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Review {
  id         String   @id @default(uuid())
  tripId     String   @map("trip_id")
  reviewerId String   @map("reviewer_id")
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  rating     Int
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")

  trip       Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  reviewer   User     @relation("Reviewer", fields: [reviewerId], references: [id])

  @@index([tripId])
  @@index([reviewerId])
  @@map("reviews")
}

model LoadPosting {
  id                 String            @id @default(uuid())
  customerId         String            @map("customer_id")
  weightKg           Float             @map("weight_kg")
  preferredDate      DateTime          @map("preferred_date")
  status             String            @default("open")
  originAddress      String            @map("origin_address")
  destinationAddress String            @map("destination_address")
  directionBearing   Float?            @map("direction_bearing")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  customer           User              @relation(fields: [customerId], references: [id])
  matches            ReturnLoadMatch[]
  negotiation        Negotiation?

  @@index([customerId])
  @@index([status])
  @@map("load_postings")
}

model ReturnLoadMatch {
  id                  String      @id @default(uuid())
  completedTripId     String      @map("completed_trip_id")
  loadPostingId       String      @map("load_posting_id")
  matchScore          Float       @map("match_score")
  fuelSavingsEstimate Float       @map("fuel_savings_estimate")
  extraEarnings       Float       @map("extra_earnings")
  status              String      @default("pending")
  createdAt           DateTime    @default(now()) @map("created_at")

  completedTrip       Trip        @relation(fields: [completedTripId], references: [id], onDelete: Cascade)
  loadPosting         LoadPosting @relation(fields: [loadPostingId], references: [id], onDelete: Cascade)

  @@index([completedTripId])
  @@index([loadPostingId])
  @@map("return_load_matches")
}

model Negotiation {
  id            String      @id @default(uuid())
  loadPostingId String      @unique @map("load_posting_id")
  status        String      @default("ongoing")
  finalPrice    Float?      @map("final_price")
  chatHistory   Json        @default("[]") @map("chat_history")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  loadPosting   LoadPosting @relation(fields: [loadPostingId], references: [id], onDelete: Cascade)

  @@map("negotiations")
}

enum KycDocumentType {
  aadhaar
  license
  background_check
}

enum KycDocumentStatus {
  pending
  approved
  rejected
}

model KycDocument {
  id          String            @id @default(uuid())
  driverId    String            @map("driver_id")
  docType     KycDocumentType   @map("doc_type")
  storageKey  String            @map("storage_key")
  status      KycDocumentStatus @default(pending)
  reviewedBy  String?           @map("reviewed_by")
  reviewedAt  DateTime?         @map("reviewed_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  driver      Driver            @relation(fields: [driverId], references: [id], onDelete: Cascade)
  reviewer    User?             @relation("KycReviewer", fields: [reviewedBy], references: [id])

  @@map("kyc_documents")
}

model Dispute {
  id         String    @id @default(uuid())
  tripId     String    @map("trip_id")
  raisedBy   String    @map("raised_by")
  reason     String
  status     String    @default("open")
  resolution String?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  trip       Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  raiser     User      @relation("DisputeRaiser", fields: [raisedBy], references: [id])

  @@map("disputes")
}

model AuditLog {
  id        String   @id @default(uuid())
  adminId   String   @map("admin_id")
  action    String
  details   String?
  createdAt DateTime @default(now()) @map("created_at")

  admin     User     @relation("AdminAuditLogs", fields: [adminId], references: [id])

  @@map("audit_logs")
}
